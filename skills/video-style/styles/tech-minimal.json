{
  "name": "tech-minimal",
  "summary": "Tech, product and tutorials. True colour, cyan keywords, UI/code and callout blocks, calm motion.",
  "colors": {
    "text": "#FFFFFF",
    "accent": "#00C3FF",
    "accent2": "#A78BFA",
    "money": "#22E07A",
    "dark": "#0B0B0F",
    "paper": "#F4ECD8",
    "paper_ink": "#1D1A16"
  },
  "fonts": {
    "display": {
      "family": "Inter",
      "files": {
        "100 900": "@engine/assets/fonts/inter/Inter-Variable.ttf"
      }
    },
    "body": {
      "family": "Inter",
      "files": {
        "100 900": "@engine/assets/fonts/inter/Inter-Variable.ttf"
      }
    },
    "captions": {
      "family": "Inter",
      "files": {
        "100 900": "@engine/assets/fonts/inter/Inter-Variable.ttf"
      }
    }
  },
  "captions": {
    "family": "Inter",
    "mode": "keywords",
    "highlight": "color",
    "case": "keep",
    "weight": 600,
    "max_emphasis": 1,
    "shadow": "0 2px 10px rgba(0,0,0,.55)",
    "plate_color": ""
  },
  "cards": {
    "bg": "rgba(8,12,18,.82)",
    "text": "#E6F1FF",
    "radius": 14,
    "border": "rgba(0,195,255,.22)"
  },
  "motion": {
    "in": 0.4,
    "out": 0.3,
    "ease_in": "power2.out",
    "ease_out": "power2.in"
  },
  "color_grade": "neutral-true",
  "audio_tone": "clear",
  "catalog": {
    "prefer_tags": [
      "code",
      "ui",
      "terminal",
      "callout",
      "lower-third",
      "captions"
    ],
    "avoid_tags": [
      "glitch",
      "paper"
    ]
  },
  "sound": {
    "palette": [
      "click-soft",
      "key-tap",
      "typing-tactile",
      "notification-chime"
    ],
    "rule": "clicks only on real clicks; typing only on real typing"
  }
}