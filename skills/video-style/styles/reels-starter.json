{
  "name": "reels-starter",
  "status": "placeholder until the reference reels are analysed (see the style skill)",
  "canvas": [
    1080,
    1920
  ],
  "colors": {
    "text": "#ffffff",
    "accent": "#ffd400",
    "accent2": "#00e0ff",
    "money": "#22e07a",
    "dark": "#0b0b0f",
    "paper": "#f4ecd8",
    "paper_ink": "#1d1a16"
  },
  "fonts": {
    "display": {
      "family": "Poppins",
      "files": {
        "500": "@engine/assets/fonts/poppins/Poppins-Medium.ttf",
        "700": "@engine/assets/fonts/poppins/Poppins-Bold.ttf",
        "800": "@engine/assets/fonts/poppins/Poppins-ExtraBold.ttf",
        "900": "@engine/assets/fonts/poppins/Poppins-Black.ttf"
      }
    },
    "scripts": [
      "latin"
    ],
    "caption_script": "roman-hinglish"
  },
  "captions": {
    "engine": "builtin",
    "mode": "phrase",
    "case": "as_spoken",
    "weight": 800,
    "stroke": 4,
    "pill_color": "",
    "emphasis": "accent"
  },
  "cards": {
    "bg": "rgba(12,12,16,.80)",
    "text": "#ffffff",
    "radius": 22,
    "border": "rgba(255,255,255,.14)"
  },
  "motion": {
    "in": 0.35,
    "out": 0.25,
    "ease_in": "power3.out",
    "ease_out": "power2.in"
  },
  "camera": {
    "punch": [
      1.08,
      1.14
    ],
    "creep": [
      1.03,
      1.06
    ],
    "origin_portrait": "50% 30%"
  },
  "pacing": {
    "visual_change_every_s": [
      1.5,
      3.0
    ]
  },
  "sound": {
    "default": "silence",
    "allowed": [
      "pop on a card",
      "click on a cursor",
      "whoosh on a whiteout only"
    ]
  },
  "audio_preset": "shorts",
  "text_stroke": 0.045
}